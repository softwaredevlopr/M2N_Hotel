# Preferred API base URL for the frontend (booking inquiry + hotel data).
NEXT_PUBLIC_API_BASE_URL=http://localhost:5001
# Legacy alias — still supported if NEXT_PUBLIC_API_BASE_URL is unset.
NEXT_PUBLIC_API_URL=http://localhost:5001
# Canonical public site URL (SEO / Open Graph). Set per environment at build time.
# Local example: http://localhost:3000
# Production example: https://www.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional. The homepage is a multi-hotel brand landing and is NOT locked to a
# single hotel. This slug is only used as a fallback (e.g. default booking
# target) when no specific hotel has been selected.
NEXT_PUBLIC_DEFAULT_HOTEL_SLUG=
