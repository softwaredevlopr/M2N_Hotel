# M2N Hotel — backend environment variables (safe placeholders only)
# Copy this file to `.env` and fill values for your environment.

# HTTP server port
PORT=5001

# Cloud PostgreSQL connection string (Render / Railway / Supabase / Neon / Heroku)
# Leave blank for local development with the per-field DB_* variables below.
DATABASE_URL=

# Public URL of the deployed frontend (added to allowed CORS origins).
FRONTEND_URL=https://m2n-hotel.vercel.app

# ---------------------------------------------------------------------------
# Admin authentication (JWT)
# Generate a long random string for JWT_SECRET. Never commit the real value.
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# ---------------------------------------------------------------------------
# First super-admin seed (`npm run seed:admin`) — placeholders only.
# Do not commit real credentials. Set these in your local `.env` only.
# ---------------------------------------------------------------------------
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# ---------------------------------------------------------------------------
# Rate limiting overrides (optional). Defaults shown; leave unset in production.
# WRITE_RATE_LIMIT_MAX covers POST /api/inquiries and POST /api/bookings.
# ---------------------------------------------------------------------------
# WRITE_RATE_LIMIT_MAX=20
# BOOKING_LOOKUP_RATE_LIMIT_MAX=60

# ---------------------------------------------------------------------------
# Email / notifications (Phase 10F). Placeholders only — SMTP is optional.
# When SMTP_HOST is empty (or EMAIL_PROVIDER=console), messages are logged.
# Future API providers (Resend, SendGrid, …) plug in via EMAIL_PROVIDER.
# ---------------------------------------------------------------------------
EMAIL_ENABLED=true
EMAIL_PROVIDER=auto
EMAIL_FROM=M2N Hotels <noreply@example.com>
# EMAIL_REPLY_TO=reservations@example.com
# EMAIL_BRAND_NAME=M2N Hotels
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ---------------------------------------------------------------------------
# Local development alternative (used only when DATABASE_URL is empty).
# Uncomment and set values for your local PostgreSQL instance.
# ---------------------------------------------------------------------------
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=m2n_hotel
# DB_USER=postgres
# DB_PASSWORD=
# DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_POOL_MAX=20
# DB_IDLE_TIMEOUT_MS=30000
# DB_CONNECTION_TIMEOUT_MS=5000
